<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
    <ViewDefinitions>
        <!-- NetDiag.SSL Format -->
        <View>
            <Name>NetDiag.SSL</Name>
            <ViewSelectedBy>
                <TypeName>NetDiag.SSL</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Hostname</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Subject CN</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Issuer</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Valid Until</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Days Left</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Valid</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Hostname</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Certificate.Subject.CommonName</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Certificate.Issuer.Organization</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Certificate.Validity.NotAfter.ToString('yyyy-MM-dd')</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Certificate.Validity.DaysRemaining</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.Certificate.Validity.Valid) { 'Yes' } else { 'No' }</ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
